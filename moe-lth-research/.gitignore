# Virtual environments
.venv/
.venv-*/

# Python cache and builds
__pycache__/
*.py[cod]
.pytest_cache/
build/
dist/
*.egg-info/

# VS Code
.vscode/

# Logs and process locks
*.log
*.lock
*.pid
*.tmp
*.so

# Backups
*.HOME_BACKUP
*.backup
*.pre_*
*.pre_sharding_backup

# Large ML checkpoints and tensor archives
*.pt
*.pth
*.ckpt
*.bin
*.npy
*.npz
*.parquet
*.jsonl

