  "optimizer_policy": "shared fresh AdamW/scaler/RNG reset in ALL branches; source checkpoints omit state",
  "training_precision": "canonical FP16 autocast; GradScaler initial65536; TF32 enabled per source configure_device",
  "validation_precision": "FP32 TF32 disabled, complete original validation batches; task-only CE token weighted",
  "candidate_definition": {
    "population": "expert fc1/fc2 weights only; each tensor independently",
    "currently_small": "bottom50% ordinal absolute magnitude at1000; ascending flat-index ties",
    "growth": "strict increases in |w| at250\u2192500 and500\u21921000; upper quartile normalized OLS slope among sustained candidates within each of50 current-magnitude rank strata",
    "stability": "lower quartile total absolute-magnitude variation across all three observations within each stratum; remove overlap with growth candidates",
    "normalization": "OLS slope and trajectory total variation divided by current tensor RMS; never individual magnitude; RMS<=1e-12 is degenerate",
    "quantiles": "ceil25% of finite eligible candidates; slope descending/index ascending, variation ascending/index ascending"
  },
  "matching": {
    "strata": 50,
    "caliper_rms_units": 0.005,
    "method": "growing candidates in descending slope order per stratum; nearest remaining stable magnitude without replacement; index ties; choose closest feasible pairs first globally per tensor, SHA25677101 tie-break",
    "dose": "round(1% of all eligible fc1/fc2 tensor coordinates), equivalent to2% of currently-small population; per-tensor deterministic min(target,feasible_pairs)",
    "reduction": "no loss-driven changes; record reduced/zero tensors; abort before loss if any seed removes <0.25% of total expert-weight coordinates or includes <80% of tensors"
  },
  "primary_endpoint": "per-source-seed final task validation CE_growing minus CE_stable at continuation1500",
  "secondary_endpoints": [
    "immediate masking CE minus newly run control",
    "fixed validation curve",
    "trapezoidal integral over registered steps of branch CE minus control CE; also divide integral by1500",
    "applied updates and AMP skips"
  ],
  "success_rule": "descriptive paired effects, all5 seeds before mean/median/range/SD/SE; no result-dependent changes or recovered threshold",
  "rng_reset_seeds": {
    "7": 7,
    "17": 17,
    "29": 29,
    "43": 43,
    "61": 61
  },
  "selection_tie_seed": 77101,
  "source_stream": "same seeded non-reshuffled loader cycle; reconstruct2500 source batches; continuation uses zero-based slice[1000:2500]",
  "engineering_gate": "pilot17 all3 COMPLETE; masks exact, finite weights/loss, expected budget, AMP skips<=100; no use of effect sign",
  "failure_policy": "preserve every failed attempt; halt remaining dispatch for numerical failures; no altered protocol or result-based retries; explicit exact resume may reuse interruption state",
  "interruption_interval": 250,
